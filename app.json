{
  "expo": {
    "name": "NumVault",
    "slug": "numvault",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "numvault",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "assets/images/icon.png",
      "assets/images/nv_s1.png",
      "assets/images/nv_s2.png",
      "assets/images/nv_s3.png"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.numvault.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0D1117"
      },
      "edgeToEdgeEnabled": true,
      "package": "ng.numvault.app",
      "versionCode": 14,
      "enableShrinkResourcesInReleaseBuilds": false,
      "enableProguardInReleaseBuilds": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "./plugins/removeStaleOnboardingAssets",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0D1117"
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#00C853"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
